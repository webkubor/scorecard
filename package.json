{
  "name": "project-scorecard",
  "private": false,
  "version": "2.2.0",
  "type": "module",
  "description": "开源项目质检：GitHub 仓库 9 维 / npm 包 7 维 / 网站 9 维 / GitHub 个人首页 7 维 / 品牌 GEO。判据对齐 NIST SSDF、OpenSSF、OWASP SAMM；读不到的项标「无法核实」不猜分。免登录。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webkubor/scorecard.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "bun server/index.js",
    "start": "bun run build && bun run server",
    "check:dimensions": "node scripts/check-dimensions.mjs",
    "audit": "node bin/scorecard.mjs",
    "check:axes": "node scripts/check-axes.mjs --strict",
    "check": "bun run check:syntax && bun run check:dimensions && bun run check:axes && bun test",
    "test": "bun test",
    "check:syntax": "node scripts/check-syntax.mjs --strict"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "hono": "^4.13.3",
    "im-notify-kit": "^0.4.0",
    "vue": "^3.4.38"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.3",
    "jsdom": "^30.1.1",
    "vite": "^5.4.6",
    "vite-plugin-refresh-guard": "^0.3.1"
  },
  "bin": {
    "scorecard": "./bin/scorecard.mjs"
  },
  "files": [
    "bin",
    "server",
    "src",
    "skills",
    "dist",
    "AGENTS.md",
    "llms.txt"
  ],
  "keywords": [
    "project-maturity",
    "repo-health",
    "project-audit",
    "open-source-metrics",
    "code-quality",
    "quality-assurance",
    "readme",
    "documentation",
    "changelog",
    "ci-cd",
    "github-actions",
    "security",
    "self-hosted",
    "llm",
    "geo",
    "generative-engine-optimization",
    "llms-txt",
    "developer-tools",
    "github"
  ]
}
